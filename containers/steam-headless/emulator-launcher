#!/usr/bin/env bash
set -euo pipefail

export HOME="${USER_HOME:-/home/steamheadless}"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

case "${0##*/}" in
    pcsx2)
        mkdir -p "$XDG_CONFIG_HOME/PCSX2"
        # PCSX2 appends /PCSX2 to -datapath. The extracted AppImage needs no FUSE.
        exec /opt/pcsx2/AppRun -datapath "$XDG_CONFIG_HOME" "$@"
        ;;
    dolphin-emu)
        exec /usr/bin/dolphin-emu "$@"
        ;;
    gopher64)
        exec /opt/gopher64/gopher64 "$@"
        ;;
    *)
        echo "Run this launcher as pcsx2, dolphin-emu, or gopher64." >&2
        exit 2
        ;;
esac
